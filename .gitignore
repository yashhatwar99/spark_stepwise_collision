# ---------------------------------------------------------------------
# Datasets. Gigabytes, and not ours to redistribute.
# data/kitti/drive_0009.zip alone is 1708 MB; GitHub blocks anything over
# 100 MB, so this must stay excluded from the very first commit -- removing
# a large file after it has entered history means rewriting the history.
# data/README.md is let through so the repo still says how to obtain it all.
# ---------------------------------------------------------------------
data/
!data/README.md

# Python environment and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Model weights. yolov8s.pt is 21 MB and both download on first run.
*.pt
*.pth
*.ckpt

# FP-TTC weights are .pth.tar (133 MB each) -- not caught by *.pth above,
# and over GitHub's 100 MB limit.
*.pth.tar

# Clone of the FP-TTC repository (github.com/LChanglin/FP-TTC). Same reason
# as 3d_bounding/ below: it has its own .git. Our local patches to it
# (mmcv_compat.py, view_results.py, run_kitti_eval.sh) show up in
# `git -C fpttc status`, not here.
fpttc/

# Clone of the RiskProp repository (github.com/xingyueye5/RiskProp). It has
# its own .git, and its own Python environment in riskprop/.venv.
riskprop/

# A clone of someone else's repository (Deep3DBox reference implementation).
# It carries its own .git, which git would otherwise half-track as a broken
# submodule. The method is reimplemented in src3/ regardless.
3d_bounding/

# Generated output. results/ is deliberately NOT ignored -- put the few
# images the README references in there.
output/
output2/
output3/
output4/
output5/

# Papers and other copyrighted material
*.pdf
*.pptx

# Leftovers from dataset download scripts
cookie
*.zip
*.tar
*.tar.gz

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code's local, machine-specific settings (allowed commands, local
# paths). Not secrets, but specific to this machine -- not useful to commit.
.claude/settings.local.json

# Scratch files not part of the project (test image, run-command notes,
# a stray paste of an unrelated chat).
conflict_check.jpg
command.txt
to pste

# Node packages for building the results slides (fpttc_results/deck)
node_modules/

# A nuScenes camera frame (example figure for the results page). nuScenes' terms
# do not let the images be redistributed. Re-create with fpttc_results/make_figures.py.
fpttc_results/figures/nuscenes_example.jpg
fpttc_results/site/img/nuscenes_example.jpg

# Method 2 (per_car_ttc/): the saved FP-TTC features used for training (~0.8 GB) are
# not committed, but the small trained head (~0.4 MB) is, despite the *.pt rule above.
per_car_ttc/learned_head/cache/
!per_car_ttc/learned_head/weights/
!per_car_ttc/learned_head/weights/*.pt

# lightweight_fpttc/: the saved FP-TTC features used for training (~1.5 GB) are not committed;
# the small trained decoder (about 1.5 MB) is.
lightweight_fpttc/removing_decoder/cache/
lightweight_fpttc/removing_flow_affine/cache/
!lightweight_fpttc/removing_decoder/weights/
!lightweight_fpttc/removing_decoder/weights/*.pt
!lightweight_fpttc/removing_flow_affine/weights/
!lightweight_fpttc/removing_flow_affine/weights/*.pt

# Distillation runs: the extra-frame features (2.9 GB) are not committed; each run's trained Conv3 (about 1.5 MB) is.
lightweight_fpttc/removing_flow_affine/distill_more_frames/cache/
!lightweight_fpttc/removing_flow_affine/distillation_only/weights/
!lightweight_fpttc/removing_flow_affine/distillation_only/weights/*.pt
!lightweight_fpttc/removing_flow_affine/distill_then_kitti/weights/
!lightweight_fpttc/removing_flow_affine/distill_then_kitti/weights/*.pt
!lightweight_fpttc/removing_flow_affine/distill_more_frames/weights/
!lightweight_fpttc/removing_flow_affine/distill_more_frames/weights/*.pt

# Leftovers of a short test run (not a result)
lightweight_fpttc/removing_flow_affine/weights/smoke.pt
lightweight_fpttc/removing_flow_affine/results/smoke*.json
lightweight_fpttc/removing_flow_affine/smoke_log.txt
