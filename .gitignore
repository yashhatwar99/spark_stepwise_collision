# ---------------------------------------------------------------------
# Datasets. Gigabytes, and not ours to redistribute.
# data/kitti/drive_0009.zip alone is 1708 MB; GitHub blocks anything over
# 100 MB, so this must stay excluded from the very first commit -- removing
# a large file after it has entered history means rewriting the history.
# data/README.md is let through so the repo still says how to obtain it all.
# ---------------------------------------------------------------------
data/
!data/README.md

# Python environment and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Model weights. yolov8s.pt is 21 MB and both download on first run.
*.pt
*.pth
*.ckpt

# FP-TTC weights are .pth.tar (133 MB each) -- not caught by *.pth above,
# and over GitHub's 100 MB limit.
*.pth.tar

# Clone of the FP-TTC repository (github.com/LChanglin/FP-TTC). Same reason
# as 3d_bounding/ below: it has its own .git. Our local patches to it
# (mmcv_compat.py, view_results.py, run_kitti_eval.sh) show up in
# `git -C fpttc status`, not here.
fpttc/

# Clone of the RiskProp repository (github.com/xingyueye5/RiskProp). It has
# its own .git, and its own Python environment in riskprop/.venv.
riskprop/

# A clone of someone else's repository (Deep3DBox reference implementation).
# It carries its own .git, which git would otherwise half-track as a broken
# submodule. The method is reimplemented in src3/ regardless.
3d_bounding/

# Generated output. results/ is deliberately NOT ignored -- put the few
# images the README references in there.
output/
output2/
output3/
output4/
output5/

# Papers and other copyrighted material
*.pdf
*.pptx

# Leftovers from dataset download scripts
cookie
*.zip
*.tar
*.tar.gz

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code's local, machine-specific settings (allowed commands, local
# paths). Not secrets, but specific to this machine -- not useful to commit.
.claude/settings.local.json

# Scratch files not part of the project (test image, run-command notes,
# a stray paste of an unrelated chat).
conflict_check.jpg
command.txt
to pste
